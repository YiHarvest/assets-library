# Copy to .env in this directory. Never commit the real file.

# Public HTTP deployment. Prefer an authenticated HTTPS reverse proxy for long-term use.
MB_JETTY_HOST=
MB_JETTY_PORT=
MB_SITE_URL=
METABASE_HEALTH_URL=
METABASE_EXTRA_HOST=
MB_SITE_NAME=Assets Library BI
MB_SITE_LOCALE=zh
JAVA_TIMEZONE=Asia/Shanghai
MB_REPORT_TIMEZONE=Asia/Shanghai
MB_ANON_TRACKING_ENABLED=false

# Metabase application metadata. This is intentionally separate from business MySQL.
MB_DB_TYPE=postgres
MB_DB_HOST=
MB_DB_PORT=
MB_DB_DBNAME=metabase
MB_DB_USER=metabase
MB_DB_PASS=
MB_ENCRYPTION_SECRET_KEY=

# Passed to the local PostgreSQL metadata container.
POSTGRES_DB=metabase
POSTGRES_USER=metabase
POSTGRES_PASSWORD=
POSTGRES_LISTEN_HOST=
POSTGRES_PORT=

# Limit the effect of accidental expensive queries on the business database.
MB_JDBC_DATA_WAREHOUSE_MAX_CONNECTION_POOL_SIZE=5
MB_UNAGGREGATED_QUERY_ROW_LIMIT=20000
MB_AGGREGATED_QUERY_ROW_LIMIT=10000

# MySQL reader credentials live in .reader.env, not in container environments.
