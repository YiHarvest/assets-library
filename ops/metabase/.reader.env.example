# Copy to .reader.env in this directory. Never commit the real file.

# The target MySQL instance sees connections through its rootless port forward
# as this exact source address. Never use the wildcard host `%`.
METABASE_MYSQL_ALLOWED_HOST=
METABASE_PRD_DB_HOST=
METABASE_PRD_DB_PORT=
METABASE_PRD_DB_NAME=assets_library
METABASE_PRD_DB_USER=reporting_reader
METABASE_PRD_DB_PASS=
DATABASE_SSL_CA_PATH=./ops/metabase/mysql-ca.pem

# Set only while a DBA provisions the reader. Remove it immediately afterwards.
# METABASE_MYSQL_ADMIN_URL=
