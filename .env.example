DATABASE_URL=mysql://assets_library_app:change-me@127.0.0.1:3306/assets_library
DATABASE_SSL_CA_PATH=
DATABASE_POOL_SIZE=20
PORT=23015
APP_MODE=prd
UPLOAD_MAX_TOTAL_BYTES=2147483648
# 待审核素材和对应临时媒体的保留时长；到期后执行硬清理。
PENDING_ASSET_RETENTION_HOURS=24
# 任务进入 done/failed 后继续保留的历史时长。
TASK_HISTORY_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600
MEDIA_ROOT=./media
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200

# 同机分镜服务。任一子视频损坏或超过 10 MiB 时，父视频整批不入库。
SCENE_DETECT_ENABLED=true
SCENE_DETECT_BASE_URL=http://127.0.0.1:28200
SCENE_DETECT_PROJECT_DIR=../scene-detect-service
SCENE_DETECT_WORKSPACE_ROOT=./media/.scene-service
SCENE_DETECT_PORT=28200
SCENE_DETECT_TIMEOUT_MS=300000
SCENE_DETECT_TASK_TTL_SECONDS=86400
SCENE_SEGMENT_MAX_BYTES=10485760

# 电信云 ZOS（S3 兼容接口）。密钥只写入未提交的 .env。
ZOS_ACCESS_KEY_ID=
ZOS_SECRET_ACCESS_KEY=
# S3 API 地址。本机开发无法访问内网 endpoint 时，在 .env 设置公网 API 地址。
ZOS_API_ENDPOINT=
# 备用 S3 API 地址；ZOS_API_ENDPOINT 为空时使用该值。
ZOS_ENDPOINT=
ZOS_BUCKET=
# 本服务长期对象的独占相对目录；共享 bucket 时必须配置，示例：test_assets。
ZOS_OBJECT_PREFIX=
ZOS_WEB_URL=
# 可选的同区域内部 S3 API 地址；前两项为空时才使用。
ZOS_INTERNAL_URL=
ZOS_FORCE_PATH_STYLE=true
ZOS_TIMEOUT_MS=300000
# 临时媒体服务使用默认目录；上传时仅提交 file，不传 path/prefix 参数。
ZOS_TEMP_UPLOAD_URL=http://127.0.0.1:11111/api/file/tmp/upload

# Vision-language model used for image and video-frame analysis.
# openai_chat_completions or openai_responses
VLM_PROTOCOL=openai_chat_completions
# NewAPI/OpenAI-compatible Base URL should include /v1.
VLM_BASE_URL=
# Leave empty only when the gateway has authentication disabled.
VLM_API_KEY=
VLM_NAME=qwen3.7-plus
# Ordered exact gateway model IDs; primary plus fallbacks supports at most 5.
VLM_FALLBACK_NAMES=
# Configure thinking per model target; the option is not shared with the LLM.
VLM_ENABLE_THINKING=false

# Text-only model group reserved for text generation and normalization tasks.
# It is parsed and validated now, but no current business flow invokes it.
LLM_PROTOCOL=openai_chat_completions
# Leave empty to reuse VLM_BASE_URL and VLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_NAME=
# Parsed now for future text-only tasks; the current business flow does not call it.
LLM_FALLBACK_NAMES=
# Apply the explicit value to every model in the LLM candidate chain.
LLM_ENABLE_THINKING=false

VLM_TIMEOUT_MS=120000
VLM_VIDEO_TIMEOUT_MS=300000
VLM_RETRY_COUNT=1
# Long cooldown for quota/model-specific failures; transient failures use at most 60s.
VLM_FAILOVER_COOLDOWN_MS=1800000

# frames: analyze browser-generated JPEG keyframes; disabled: reject video analysis.
VLM_VIDEO_MODE=frames

# Semantic search: local Chroma persists analysis-result vectors.
CHROMA_URL=http://127.0.0.1:23016
CHROMA_COLLECTION=asset_analysis
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
# OpenAI-compatible embedding endpoint. Empty endpoint/key values reuse the
# first configured model target (VLM, then LLM).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
