DATABASE_URL=
DATABASE_SSL_CA_PATH=
# Compose只读挂载宿主CA到容器固定路径；不要把整个data目录放进镜像。
DATABASE_SSL_CA_HOST_PATH=
DATABASE_POOL_SIZE=20
PORT=23015
APP_MODE=prd
# 浏览器始终访问 PORT；NestJS 可监听回环或 0.0.0.0，由 Next 同源转发 /api/v1。
# 即使监听 0.0.0.0，BACKEND_URL 仍应填写可访问的 127.0.0.1/localhost 地址。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=23017
BACKEND_URL=
# 允许调用API的浏览器Origin；多个第三方前端用英文逗号分隔。
FRONTEND_ORIGIN=h
# 只有严格等于 true 时，一键启动才执行 Drizzle migration；false 时明确跳过。
RUN_DATABASE_MIGRATIONS=false
NEXT_PUBLIC_BASE_PATH=
RUNTIME_DIR=./.run
CHROMA_DATA_DIR=
APP_WAIT_SECONDS=90
# 大于 worker 默认30秒优雅退出窗口，避免在状态落盘前SIGKILL。
PROCESS_STOP_TIMEOUT_SECONDS=35
SLOW_OPERATION_MS=1000
# 单进程每分钟最多接收的前端观测事件数；超限返回 429，不影响业务请求。
OBSERVABILITY_EVENTS_PER_MINUTE=3000
# 临时上传 user_id 审计使用独立HMAC盐；生产请执行 `openssl rand -hex 32` 后写入未提交的 .env。
TEMP_UPLOAD_AUDIT_SALT=
TEMP_UPLOAD_IP_REQUESTS_PER_MINUTE=120
TEMP_UPLOAD_USER_REQUESTS_PER_MINUTE=60
TEMP_UPLOAD_BATCH_MAX_BYTES=209715200
TEMP_UPLOAD_DISK_QUOTA_BYTES=1073741824
TEMP_UPLOAD_MAX_ACTIVE_FILES=32
LOG_TIME_ZONE=Asia/Shanghai
# 运行日志按天轮转，保留7天；清理器每小时检查一次。
LOG_RETENTION_DAYS=7
LOG_CLEANUP_INTERVAL_SECONDS=3600
# ZOS tmp 对象和待入库元数据的有效时间。
TEMP_FILE_TTL_HOURS=24
# 任务进入 done/failed 后继续保留的历史时长。
TASK_HISTORY_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600
WORKER_POLL_MS=1000
# 本地 worker 进程数；任务通过 MySQL SKIP LOCKED 原子抢占。worker-1 负责维护循环。
WORKER_INSTANCES=1
# 每个 worker 独立连接池大小；一键启动时覆盖 worker 进程的 DATABASE_POOL_SIZE。
WORKER_DATABASE_POOL_SIZE=5
# running 作业超过该时间且没有 heartbeat 才会回队；长任务会持续续租。
WORKER_STALE_SECONDS=300
WORKER_MAINTENANCE_SECONDS=60
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
CALLBACK_TIMEOUT_MS=60000
CALLBACK_MAX_ATTEMPTS=5
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200

# 同机分镜服务。任一子视频损坏或超过 10 MiB 时，父视频整批不入库。
SCENE_DETECT_BASE_URL=
SCENE_DETECT_PROJECT_DIR=
SCENE_DETECT_WORKSPACE_ROOT=
SCENE_DETECT_PORT=28200
SCENE_DETECT_WAIT_SECONDS=30
# 分镜 /health 实测约4秒；Nest聚合健康与一键启动共用该超时。
SCENE_HEALTH_TIMEOUT_MS=8000
# 异步分镜总预算（上传 + 排队 + 执行）与轮询间隔
SCENE_DETECT_TIMEOUT_MS=600000
SCENE_DETECT_POLL_INTERVAL_MS=1000
# 弹性分镜 worker 上限；一任务一 worker，完成即释放，满载后继续排队
SCENE_DETECT_MAX_WORKERS=2
SCENE_DETECT_TASK_TTL_SECONDS=86400
SCENE_SEGMENT_MAX_BYTES=10485760

# 电信云 ZOS（S3 兼容接口）。密钥只写入未提交的 .env。
ZOS_ACCESS_KEY_ID=
ZOS_SECRET_ACCESS_KEY=
# S3 API 地址。本机开发无法访问内网 endpoint 时，在 .env 设置公网 API 地址。
ZOS_API_ENDPOINT=
ZOS_REGION=
ZOS_BUCKET=
ZOS_WEB_URL=
ZOS_FORCE_PATH_STYLE=false
# 临时同步上传和永久上传入库前对象都由NestJS直接写入项目独占tmp目录。
ZOS_TMP_PREFIX=
ZOS_PERMANENT_PREFIX=
# 预签名 PUT 固定有效 24h，过期后不重新签发。
UPLOAD_URL_TTL_SECONDS=86400

# Vision-language model used for image and video-frame analysis.
# openai_chat_completions or openai_responses
VLM_PROTOCOL=openai_chat_completions
# NewAPI/OpenAI-compatible Base URL should include /v1.
VLM_BASE_URL=
# Leave empty only when the gateway has authentication disabled.
VLM_API_KEY=
VLM_NAME=qwen3.7-plus
# Ordered exact gateway model IDs; primary plus fallbacks supports at most 5.
VLM_FALLBACK_NAMES=
# Configure thinking per model target; the option is not shared with the LLM.
VLM_ENABLE_THINKING=false

VLM_TIMEOUT_MS=120000
VLM_VIDEO_TIMEOUT_MS=300000
VLM_RETRY_COUNT=1
# Long cooldown for quota/model-specific failures; transient failures use at most 60s.
VLM_FAILOVER_COOLDOWN_MS=1800000

# 预留的纯文本 LLM 配置（按要求保留）；当前素材分析仍使用上面的 VLM。
LLM_PROTOCOL=openai_chat_completions
LLM_BASE_URL=
LLM_API_KEY=
LLM_NAME=
LLM_FALLBACK_NAMES=
LLM_ENABLE_THINKING=false

# Semantic search: local Chroma persists analysis-result vectors.
CHROMA_URL=
CHROMA_PORT=23016
CHROMA_VERSION=1.5.9
CHROMA_INDEX_URL=
CHROMA_WAIT_SECONDS=30
CHROMA_COLLECTION=
CHROMA_TENANT=
CHROMA_DATABASE=
# OpenAI-compatible embedding endpoint。语义检索要求显式配置 BASE_URL 和 MODEL；
# API_KEY 仅在目标服务需要鉴权时填写，未配置时语义检索自动禁用。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
