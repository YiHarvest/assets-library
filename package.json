{
  "name": "multimodal-asset-library",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev --turbo\" \"tsx watch --env-file=.env src/worker/index.ts\"",
    "build": "next build",
    "start": "pnpm run webui-lock:check && next start",
    "start:web": "pnpm run webui-lock:check && next start",
    "start:worker": "tsx --env-file=.env src/worker/index.ts",
    "start:scene": "./scripts/run-scene-service.sh",
    "start:all": "pnpm run webui-lock:check && concurrently -k -n web,worker -c cyan,magenta \"next start\" \"tsx --env-file=.env src/worker/index.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check-target": "tsx --env-file=.env src/server/db/check-target.ts",
    "db:migrate": "tsx --env-file=.env src/server/db/migrate.ts",
    "webui-lock:check": "tsx --env-file=.env src/server/auth/check-webui-lock.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@smithy/node-http-handler": "^4.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.4",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
