# dev 使用配置中的远程服务地址；prd 将内部服务主机切换到本机回环地址。
APP_MODE=dev

# 生产部署前缀（如 /feisu/assets-library）。开发环境留空；生产环境由部署脚本注入。
# 所有 API、Location、media_url 均会自动带此前缀。
NEXT_PUBLIC_BASE_PATH=

# 可信内网页面锁。dev 留空时关闭；prd 必填且至少 32 字符。
# 生成方式：openssl rand -hex 32。禁止使用 NEXT_PUBLIC_ 前缀。
WEBUI_LOCK_KEY=

# MCP Streamable HTTP endpoint bearer token. Keep server-only and at least 32 bytes.
# Generate with: openssl rand -hex 32
MCP_ACCESS_TOKEN=

# MCP upload_from_url 的默认 user_id：服务端注入，工具参数不暴露 user_id。
# 每个调用方分配一个专属值即可天然数据隔离；不配置时个人素材操作不可用。
MCP_DEFAULT_USER_ID=

# 逗号分隔的允许 user_id 白名单，用于 x-request-userid 请求头。
# 剪辑 agent 想切换访问哪些用户，就把这些 user_id 列进来。
MCP_ALLOWED_USER_IDS=

# 任意用户模式：开启后 x-request-userid 可传任意值（agent 可访问任意注册用户）。
# 默认 false（白名单模式）。开启需谨慎：等价于 token 持有者可代理任意用户。
MCP_ALLOW_ANY_USER_ID=false

# 逗号分隔的额外 SSRF 白名单域名（不含端口），用于 upload_from_url 拉取。
# 默认白名单来自 ZOS_WEB_URL / ZOS_INTERNAL_URL 的 host。
MCP_ALLOWED_DOMAINS=

PRD_INTERNAL_SERVICE_HOST=
DATABASE_URL=
DEV_DATABASE_NAME=assets_library_dev_test
PRD_DATABASE_NAME=assets_library
# 集成/E2E 会清空此库；必须使用独立的 *_test 数据库。
TEST_DATABASE_URL=
TEST_PRD_INTERNAL_SERVICE_HOST=
TEST_SCENE_DETECT_BASE_URL=
TEST_CHROMA_URL=
DATABASE_SSL_CA_PATH=
# Web 与 worker 各自持有连接池；两者合计上限默认为 12
DATABASE_POOL_SIZE=6
UPLOAD_MAX_ITEMS=100
UPLOAD_MAX_TOTAL_BYTES=2147483648
# .run/app.log 超过该大小时，下次启动自动按 UTC 时间戳轮转（默认 100 MiB）。
APP_LOG_MAX_BYTES=104857600
STAGING_RETENTION_HOURS=24
TASK_RETENTION_DAYS=7
CLEANUP_INTERVAL_SECONDS=3600
MEDIA_ROOT=./media
# auto 优先使用 NVIDIA 加速，不可用时自动回退 CPU
FFMPEG_HW_ACCEL=auto
# 主应用数据库作业并发数（SKIP LOCKED 安全领取）
WORKER_CONCURRENCY=4
# 多任务竞争时每个任务最多占用 2 个分析 worker；单任务时可使用全部 worker
WORKER_ANALYZE_TASK_SOFT_LIMIT=2
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200

# 同机分镜服务。任一子视频损坏或超过 10 MiB 时，父视频整批不入库。
SCENE_DETECT_ENABLED=true
SCENE_DETECT_BASE_URL=
SCENE_DETECT_PROJECT_DIR=./scene-detect-service
SCENE_DETECT_WORKSPACE_ROOT=./media/.scene-service
SCENE_DETECT_PORT=
SCENE_DETECT_LISTEN_HOST=
# 异步队列模式下 POST 立即返回、客户端轮询；总预算需覆盖排队时间
SCENE_DETECT_TIMEOUT_MS=600000
# 状态轮询间隔
SCENE_DETECT_POLL_INTERVAL_MS=1000
# 分片下载/验证/抽帧的并发上限
SCENE_SEGMENT_CONCURRENCY=8
# 父视频、分片与缩略图上传 ZOS 的并发上限
SCENE_PERSIST_CONCURRENCY=8
# 分镜服务同时处理的视频数
SCENE_DETECT_WORKERS=4
# 队列容量与失败重试次数
SCENE_DETECT_QUEUE_MAX_SIZE=20
SCENE_DETECT_QUEUE_MAX_RETRIES=1
SCENE_DETECT_TASK_TTL_SECONDS=86400
SCENE_SEGMENT_MAX_BYTES=10485760

# 电信云 ZOS（S3 兼容接口）。密钥只写入未提交的 .env。
ZOS_ACCESS_KEY_ID=
ZOS_SECRET_ACCESS_KEY=
# S3 API 地址。本机开发无法访问内网 endpoint 时，在 .env 设置公网 API 地址。
ZOS_API_ENDPOINT=
# 备用 S3 API 地址；ZOS_API_ENDPOINT 为空时使用该值。
ZOS_ENDPOINT=
ZOS_BUCKET=
ZOS_WEB_URL=
# 可选的同区域内部 S3 API 地址；前两项为空时才使用。
ZOS_INTERNAL_URL=
ZOS_FORCE_PATH_STYLE=true
ZOS_TIMEOUT_MS=300000

# Vision-language model used for image and video-frame analysis.
# openai_chat_completions or openai_responses
VLM_PROTOCOL=openai_chat_completions
# NewAPI/OpenAI-compatible Base URL should include /v1.
VLM_BASE_URL=
# Leave empty only when the gateway has authentication disabled.
VLM_API_KEY=
VLM_NAME=qwen3.7-plus
# Ordered exact gateway model IDs; primary plus fallbacks supports at most 5.
VLM_FALLBACK_NAMES=
# Configure thinking per model target; the option is not shared with the LLM.
VLM_ENABLE_THINKING=false

# Text-only model group reserved for text generation and normalization tasks.
# It is parsed and validated now, but no current business flow invokes it.
LLM_PROTOCOL=openai_chat_completions
# Leave empty to reuse VLM_BASE_URL and VLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_NAME=
# Parsed now for future text-only tasks; the current business flow does not call it.
LLM_FALLBACK_NAMES=
# Apply the explicit value to every model in the LLM candidate chain.
LLM_ENABLE_THINKING=false

VLM_TIMEOUT_MS=120000
VLM_VIDEO_TIMEOUT_MS=120000
VLM_MAX_OUTPUT_TOKENS=1280
# Includes per-target concurrency queueing, the initial request and text-only repair.
VLM_PRIMARY_BUDGET_MS=60000
VLM_TOTAL_BUDGET_MS=90000
# Retry the same target only when a transient failure arrives within this window.
VLM_FAST_RETRY_WINDOW_MS=5000
VLM_RETRY_COUNT=1
# Cap concurrent requests to each base URL + model while keeping global workers independent.
VLM_MAX_CONCURRENCY_PER_TARGET=2
# Long cooldown for quota/model-specific failures; transient failures use at most 60s.
VLM_FAILOVER_COOLDOWN_MS=1800000

# frames: analyze browser-generated JPEG keyframes; disabled: reject video analysis.
VLM_VIDEO_MODE=frames

# Semantic search: local Chroma persists analysis-result vectors.
CHROMA_URL=
CHROMA_PORT=
CHROMA_LISTEN_HOST=
CHROMA_INDEX_URL=
CHROMA_COLLECTION=asset_analysis
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
# OpenAI-compatible embedding endpoint. Empty endpoint/key values reuse the
# first configured model target (VLM, then LLM).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Runtime listener and server-side self-access.
PORT=
API_INTERNAL_ORIGIN=
WEB_LISTEN_HOST=

# E2E listener and health-check endpoints.
E2E_PORT=
E2E_BASE_URL=
E2E_SERVER_URL=

# Swagger UI browser assets.
SWAGGER_UI_STYLESHEET_URL=
SWAGGER_UI_BUNDLE_URL=
